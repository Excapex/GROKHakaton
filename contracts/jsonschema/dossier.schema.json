{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nalaznik.local/contracts/dossier.schema.json",
  "title": "Dossier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_run_id",
    "summary",
    "coverage",
    "observations",
    "findings",
    "questions",
    "next_actions",
    "integrity_report",
    "change_set_ids"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "review_run_id": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked_rules", "skipped_rules", "unknown_slots"],
      "properties": {
        "checked_rules": { "type": "array", "items": { "type": "string" } },
        "skipped_rules": { "type": "array", "items": { "type": "string" } },
        "unknown_slots": { "type": "array", "items": { "type": "string" } }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/observation" }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/finding" }
    },
    "questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/question" }
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/next_action" }
    },
    "integrity_report": { "$ref": "#/$defs/integrity_report" },
    "change_set_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "search_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documents", "pages", "queries"],
      "properties": {
        "documents": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "pages": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "queries": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "slot", "value", "evidence_id"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "id": { "type": "string", "minLength": 1 },
        "slot": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "number", "null"] },
        "unit": { "type": "string" },
        "element_id": { "type": "string" },
        "evidence_id": { "type": "string", "minLength": 1 },
        "search_scope": { "$ref": "#/$defs/search_scope" },
        "confidence_note": { "type": "string" },
        "verified_by_second_pass": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "value": { "type": "null" } }, "required": ["value"] },
          "then": { "required": ["search_scope"] }
        }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "rule_id",
        "status",
        "observation_ids",
        "severity",
        "rationale"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "id": { "type": "string", "minLength": 1 },
        "rule_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail", "conflict", "unknown"] },
        "observation_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "severity": { "enum": ["low", "medium", "high"] },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "conflict" } }, "required": ["status"] },
          "then": {
            "properties": {
              "observation_ids": { "minItems": 2 }
            }
          }
        }
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "prompt", "finding_ids", "blocking"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "id": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "finding_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "blocking": { "type": "boolean" }
      }
    },
    "next_action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "question_id"],
          "properties": {
            "kind": { "const": "ask" },
            "question_id": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "change_set_id"],
          "properties": {
            "kind": { "const": "propose_patch" },
            "change_set_id": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "description", "reason"],
          "properties": {
            "kind": { "const": "design_task" },
            "description": { "type": "string", "minLength": 1 },
            "reason": { "enum": ["unsupported_format", "physical_change"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "revision_id"],
          "properties": {
            "kind": { "const": "verify_revision" },
            "revision_id": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "integrity_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "broken_links",
        "unknown_without_scope",
        "positive_without_evidence",
        "conflicts_with_single_source"
      ],
      "properties": {
        "ok": { "type": "boolean" },
        "broken_links": { "type": "array", "items": { "type": "string" } },
        "unknown_without_scope": { "type": "array", "items": { "type": "string" } },
        "positive_without_evidence": { "type": "array", "items": { "type": "string" } },
        "conflicts_with_single_source": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
