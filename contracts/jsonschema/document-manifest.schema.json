{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saglasnik.local/contracts/document-manifest.schema.json",
  "title": "DocumentManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "source_filename",
    "input_hash",
    "page_count",
    "pages"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "document_id": { "type": "string", "minLength": 1 },
    "source_filename": { "type": "string", "minLength": 1 },
    "input_hash": { "type": "string", "minLength": 1 },
    "page_count": { "type": "integer", "minimum": 1 },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_no",
        "width_pt",
        "height_pt",
        "rotation",
        "has_text",
        "is_scanned",
        "text_layer_count",
        "char_count",
        "readability",
        "regions",
        "text_artifact",
        "render_artifact"
      ],
      "properties": {
        "page_no": { "type": "integer", "minimum": 1 },
        "width_pt": { "type": "number", "exclusiveMinimum": 0 },
        "height_pt": { "type": "number", "exclusiveMinimum": 0 },
        "rotation": { "type": "integer" },
        "has_text": { "type": "boolean" },
        "is_scanned": { "type": "boolean" },
        "text_layer_count": { "type": "integer", "minimum": 0 },
        "char_count": { "type": "integer", "minimum": 0 },
        "readability": { "enum": ["full", "partial"] },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "w", "h"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "w": { "type": "number" },
              "h": { "type": "number" }
            }
          }
        },
        "text_artifact": { "type": "string", "minLength": 1 },
        "render_artifact": { "type": "string", "minLength": 1 }
      }
    }
  }
}
